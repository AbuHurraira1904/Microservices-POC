# =============================================================================
# INVENTORY SERVICE SETTINGS
# Copy this file to ".env" in the same folder and fill in the blanks.
# ".env" is listed in .gitignore on purpose: it holds secrets and must never be
# committed. This example file is safe to commit because it holds no real values.
# =============================================================================

# Port number. NOTE: not read by the code yet (the port is fixed at 4002 in
# index.js); kept so the setting exists when the code is changed to use it.
PORT=4002

# --- Database (PostgreSQL) ----------------------------------------------------
# With the docker-compose.yml in this project: host localhost, port 5432,
# user poc, password poc_password, database poc_db.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Security (JWT) -----------------------------------------------------------
# Secret used to check login tokens, at least 32 characters. It must be EXACTLY
# the same value as in the Order service, which creates the tokens. The service
# refuses to start without it. Generate one with:  openssl rand -hex 32
# PRODUCTION: a secrets manager, and asymmetric keys (see auth.js).
JWT_SECRET=
