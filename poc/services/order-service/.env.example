# =============================================================================
# ORDER SERVICE SETTINGS
# Copy this file to ".env" in the same folder and fill in the blanks.
# ".env" is listed in .gitignore on purpose: it holds secrets and must never be
# committed.
# =============================================================================

# Port number. NOTE: not read by the code yet (the port is fixed at 4001 in
# index.js); kept so the setting exists when the code is changed to use it.
PORT=4001

# --- Database (PostgreSQL) ----------------------------------------------------
# With the docker-compose.yml in this project: host localhost, port 5432,
# user poc, password poc_password, database poc_db.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Other services this one calls --------------------------------------------
# Web address of the Inventory service, e.g. http://localhost:4002
INVENTORY_SERVICE_URL=""
# Address (host:port, no http://) of the Payment service, e.g. localhost:50051
PAYMENT_SERVICE_ADDR=""

# --- RabbitMQ (events are published here by the outbox relay) -----------------
# e.g. amqp://poc:poc_password@localhost:5672
RABBITMQ_URL=""
# Must match the exchange the Notification service listens on.
RABBITMQ_EXCHANGE=orders
# How often the outbox relay looks for unpublished events (ms)
OUTBOX_RELAY_INTERVAL_MS=1000

# --- Security -----------------------------------------------------------------
# JWT signing secret, at least 32 characters. SAME value in Order and Inventory.
# The service refuses to start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
# Demo login passwords (stub users "customer" and "admin")
# PRODUCTION: real users with hashed passwords in an identity service.
DEMO_CUSTOMER_PASSWORD=
DEMO_ADMIN_PASSWORD=
# Folder with ca.crt and the order client certificate (default: ../../certs). Never commit certificates.
# CERTS_DIR=
