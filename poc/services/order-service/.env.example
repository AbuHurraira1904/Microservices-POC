PORT=4001
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
INVENTORY_SERVICE_URL=""
PAYMENT_SERVICE_ADDR=""
RABBITMQ_URL=""
RABBITMQ_EXCHANGE=orders
# How often the outbox relay looks for unpublished events (ms)
OUTBOX_RELAY_INTERVAL_MS=1000
# JWT signing secret, at least 32 characters. SAME value in Order and Inventory.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
# Demo login passwords (stub users "customer" and "admin")
DEMO_CUSTOMER_PASSWORD=
DEMO_ADMIN_PASSWORD=
# Folder with ca.crt and the order client certificate (default: ../../certs). Never commit certificates.
# CERTS_DIR=
