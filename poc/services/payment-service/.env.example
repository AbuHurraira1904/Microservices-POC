PORT=50051
# Share of charges the simulated processor declines (0 = never, 1 = always). Must be a number:
# an empty value is read as NaN and every charge is declined.
FAILURE_RATE=0.2
# Simulated processing time per charge (ms)
LATENCY_MS=300
# Folder with ca.crt, payment.key, payment.crt (default: ../../certs). Never commit certificates.
# CERTS_DIR=
