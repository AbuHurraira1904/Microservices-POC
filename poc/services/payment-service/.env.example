# =============================================================================
# PAYMENT SERVICE SETTINGS  (the simulated payment processor)
# Copy this file to ".env" in the same folder.
# ".env" is listed in .gitignore on purpose and must never be committed.
# =============================================================================

# Port the gRPC server listens on.
PORT=50051

# --- Demo behaviour ------------------------------------------------------------
# Share of charges the simulated processor declines (0 = never, 1 = always). Must be a number:
# an empty value is read as NaN and every charge is declined.
# Use 0 for smooth demos, 1 to show the "payment declined" path.
FAILURE_RATE=0.2
# Simulated processing time per charge (ms)
# Raise it above 3000 to make the Order service's 3-second limit trigger (HTTP 504).
LATENCY_MS=300

# --- mTLS certificates ---------------------------------------------------------
# Folder with ca.crt, payment.key, payment.crt (default: ../../certs). Never commit certificates.
# CERTS_DIR=
