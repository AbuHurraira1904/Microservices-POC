RABBITMQ_URL=amqp://poc:poc_password@localhost:5672
RABBITMQ_EXCHANGE=orders
RABBITMQ_QUEUE=notification.orders
# Routing-key pattern this service listens to
RABBITMQ_BINDING=order.*
# Demo helper: artificial processing time per message (ms), so you can see messages in flight
PROCESSING_DELAY_MS=0
# Postgres (idempotency table processed_events lives in the same database as the other services)
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Demo helper: pause after the DB commit, before the ack (ms), to show duplicate skipping
ACK_DELAY_MS=0
# Dead-letter exchange and queue for rejected messages
RABBITMQ_DLX=orders.dlx
RABBITMQ_DLQ=notification.orders.dlq
