# =============================================================================
# NOTIFICATION SERVICE SETTINGS
# Copy this file to ".env" in the same folder and fill in the blanks.
# ".env" is listed in .gitignore on purpose: it holds secrets and must never be
# committed.
# =============================================================================

# --- RabbitMQ (the message broker) --------------------------------------------
# Address and login of the broker. The values below match docker-compose.yml.
RABBITMQ_URL=amqp://poc:poc_password@localhost:5672
# The exchange the Order service publishes to. Must match Order's setting.
RABBITMQ_EXCHANGE=orders
# This service's own waiting line of messages.
RABBITMQ_QUEUE=notification.orders
# Which events are copied into the queue: "order.*" = every event whose name
# starts with "order." (order.confirmed, order.failed).
RABBITMQ_BINDING=order.*
# Where rejected messages are parked instead of being discarded (the
# dead-letter exchange and queue). Changing the queue name later needs the old
# queue deleted in the RabbitMQ web page.
RABBITMQ_DLX=orders.dlx
RABBITMQ_DLQ=notification.orders.dlq

# --- Database (PostgreSQL) ----------------------------------------------------
# Used only for the table of already-handled event ids (processed_events), which
# stops the same event from being handled twice. The same database as the other
# services is fine for the demo.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Demo helpers (leave at 0 for normal use) ---------------------------------
# Artificial processing time per message (milliseconds), so you can see
# messages "in flight" and stop the service while one is being handled.
PROCESSING_DELAY_MS=0
# Pause AFTER the database commit but BEFORE the acknowledgement (milliseconds).
# Stopping the service during this pause makes RabbitMQ redeliver the message,
# which demonstrates duplicate skipping.
ACK_DELAY_MS=0
